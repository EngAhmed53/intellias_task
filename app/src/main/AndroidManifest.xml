<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Client (UI). Runs in the default app process. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Metadata service. android:process=":metadata" => private process named <pkg>:metadata.
             exported=false => only this app can bind. -->
        <service
            android:name=".service.CatalogService"
            android:process=":metadata"
            android:exported="false" />
    </application>
</manifest>
